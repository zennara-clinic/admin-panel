# Zennara unified panel — environment
#
# The panel talks to the Zennara API for everything; there is no local data.

# Backend API origin (no trailing slash, no /api suffix).
# Local development:
VITE_API_BASE_URL=http://localhost:8000
# Production:
# VITE_API_BASE_URL=https://api.zennara.in

# Live dictation in the doctor's consultation screen.
# Leave blank to fall back to the browser's own speech engine (Chrome/Edge).
VITE_DEEPGRAM_API_KEY=
